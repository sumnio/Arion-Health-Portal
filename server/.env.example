PORT=5000
MONGODB_URI=
MONGODB_DB_NAME=
NODE_ENV=production
# Comma-separated explicit origins are supported; never use * with credentials.
CORS_ORIGIN=https://<app-domain>
# Required outside tests: use a unique random value of at least 32 characters.
AUTH_SECRET=
# Required for Admin MFA: generate a random 32-byte value and base64-encode it.
MFA_ENCRYPTION_KEY=
# Dedicated keyed-hash secret for verification codes and password-reset tokens. Do not reuse AUTH_SECRET.
ACCOUNT_TOKEN_HMAC_SECRET=
# Use resend only when provider credentials and a verified sender are configured. Local/test defaults to a silent fake adapter.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=https://<app-domain>
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX=5
ADMIN_PROVISION_RATE_LIMIT_WINDOW_MS=900000
ADMIN_PROVISION_RATE_LIMIT_MAX=20
MFA_VERIFY_RATE_LIMIT_WINDOW_MS=600000
MFA_VERIFY_RATE_LIMIT_MAX=5
EMAIL_VERIFICATION_ATTEMPT_RATE_LIMIT_WINDOW_MS=600000
EMAIL_VERIFICATION_ATTEMPT_RATE_LIMIT_MAX=10
EMAIL_VERIFICATION_RESEND_RATE_LIMIT_WINDOW_MS=3600000
EMAIL_VERIFICATION_RESEND_RATE_LIMIT_MAX=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
ADMIN_CONTACT_NUMBER=
CLINIC_TIME_ZONE=Asia/Manila
CLINIC_OPEN_TIME=
CLINIC_CLOSE_TIME=
CLINIC_NAME=
CLINIC_LOCATION=
# Keep false in restricted Production until protected Doctor signature storage and rendering are implemented.
CERTIFICATE_ISSUANCE_ENABLED=false
