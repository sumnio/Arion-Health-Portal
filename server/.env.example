PORT=5000
MONGODB_URI=
NODE_ENV=development
# Comma-separated explicit origins are supported; never use * with credentials.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Required outside tests: use a unique random value of at least 32 characters.
AUTH_SECRET=
# Required for Admin MFA: generate a random 32-byte value and base64-encode it.
MFA_ENCRYPTION_KEY=
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX=5
ADMIN_PROVISION_RATE_LIMIT_WINDOW_MS=900000
ADMIN_PROVISION_RATE_LIMIT_MAX=20
MFA_VERIFY_RATE_LIMIT_WINDOW_MS=600000
MFA_VERIFY_RATE_LIMIT_MAX=5
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
ADMIN_CONTACT_NUMBER=
CLINIC_TIME_ZONE=Asia/Manila
CLINIC_OPEN_TIME=
CLINIC_CLOSE_TIME=
CLINIC_NAME=Arion Health Clinic
CLINIC_LOCATION=
