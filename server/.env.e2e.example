# Copy to server/.env.e2e for local E2E runs. Never commit real credentials.
# Use a dedicated database whose name contains "e2e".
E2E_MONGODB_URI=mongodb://127.0.0.1:27017/arion_health_e2e

# Committed test-only values. Never reuse these in development or production.
E2E_AUTH_SECRET=arion-e2e-auth-secret-local-tests-only
E2E_MFA_ENCRYPTION_KEY=ExMTExMTExMTExMTExMTExMTExMTExMTExMTExMTExM=

E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_URL=http://127.0.0.1:5000
CORS_ORIGIN=http://127.0.0.1:5173
