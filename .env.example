# Public frontend configuration only. Never place backend secrets in VITE_ variables.
# Same-origin production uses an intentionally empty value. The committed
# .env.development supplies http://127.0.0.1:5000 for local Vite development.
VITE_API_BASE_URL=
# Public feature flag only. Restricted Production must set false.
VITE_CERTIFICATE_ISSUANCE_ENABLED=false
